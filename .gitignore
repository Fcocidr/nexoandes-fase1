# Terraform: nunca versionar state, planes ni directorio local de providers
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
plan.txt
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Variables locales. fase1.tfvars SI se versiona: solo contiene valores de identificacion, sin secretos
*.tfvars
*.tfvars.json
!terraform/fase1.tfvars

# Credenciales y secretos
*.pem
*.key
.env
.aws/
credentials

# Editor y sistema operativo
.vscode/
.DS_Store
Thumbs.db
